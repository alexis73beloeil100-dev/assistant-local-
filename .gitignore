# Environnement Python : se reconstruit avec requirements.txt
.venv/

# Sorties de construction : se reconstruisent avec reconstruire.py
build/
dist/
installateur/
*.spec.bak

# Donnees de fonctionnement, propres a chaque machine
data/
erreurs.log

# Dossiers de test crees a la volee
bac_de_test/
bac_suppression/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Editeurs
.vscode/
.idea/
*.swp

# Windows
Thumbs.db
desktop.ini

# Genere par outils/paquet_maj.py a chaque paquet de mise a jour, avec un
# SourceDir absolu propre a la machine qui construit.
mise_a_jour.iss

# Note de travail locale. Elle nomme cette machine, ses disques de sauvegarde
# et ce qui s'est decide en session : elle reste ici, pas dans le depot.
REPRISE.md

# OpenRGB ne fait plus partie de l'application : ni dans le depot, ni dans le
# paquet. Le dossier ne sert plus que si on y pose une copie portable.
outils/OpenRGB/
